# ENV VARIABLES - DOCKER SETUP ONLY
# EACH RESPECTIVE PACKAGE NEEDS THEIR OWN ENV VARIABLES FOUND IN THEIR RESPECTIVE SCOPES

# PORTS
CLIENT_PORT = 3000
SERVER_PORT = 4000

# CLIENT
SERVER = http://localhost:4000
